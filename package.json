{
  "name": "formmirror",
  "version": "1.0.0",
  "description": "Screenshot-to-Autofill Chrome Extension - Privacy-first form filling from images",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "preact": "^10.19.3",
    "tesseract.js": "^5.0.4"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.21",
    "@preact/preset-vite": "^2.8.1",
    "@types/chrome": "^0.0.258",
    "@types/node": "^20.11.5",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^27.0.1",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vitest": "^1.2.1"
  },
  "license": "Apache-2.0",
  "keywords": [
    "chrome-extension",
    "autofill",
    "ocr",
    "privacy",
    "form-filling",
    "tesseract"
  ]
}
